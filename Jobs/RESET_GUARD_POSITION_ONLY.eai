#IFDEF GLOBAL
#ELSE
function ResetGuardPositionOnlyJob takes unit u returns nothing
  call DisplayToAllJobDebug("RESET_GUARD_POSITION ONLY JOB START")
  if not IsStandardUnit(u) then
    return // do nothing
  endif
  call CreateDebugTag("RECYCLE", 10, u, 3.00, 1.50)
  call RecycleGuardPositionAM(u)
  if not IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and not isfleeing then
    call DebugHeroAddAssault(60, GetUnitTypeId(u), "Jobs/RESET_GUARD_POSITION_ONLY.eai:ResetGuardPositionOnlyJob:11") // Add units back to the assault group to stop them running home from the combat
  endif
endfunction
#ENDIF