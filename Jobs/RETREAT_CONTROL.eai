#IFDEF GLOBAL
    unit major_hero = null
    real battle_radius = 1500
    real normal_battle_radius = 1500  // units within that radius are considered belonging to the current battle
    real creep_battle_radius = 750  // same as with normal_battle_radius, but for battles against creeps
    boolean retreat_controlled = false
    location home_location = null
    real enemy_strength_sum = 0
    real ally_strength_sum = 0
    boolean canflee = false
    boolean isfleeing = false
    boolean retreat_end_switch = false
    integer added_target_aggression = 0  // The current bonus aggression added to current attack specified in the profiles
    integer added_racial_aggression = 0  // The current bonus added to current attack based on which race amai is attacking
    group in_retreat_group = CreateGroup()
    group retreat_reset_pending = CreateGroup()

    location enemy_loc = Location(0,0)
    location last_enemy_loc = Location(0,0)
    location ally_loc = Location(0,0)
    location last_ally_loc = Location(0,0)

    integer debug_retreat_epoch = 0
    integer debug_retreat_run_seq = 0

    group debug_flee_candidate_group = CreateGroup()

    integer debug_retreat_transit_id = 0
    boolean debug_retreat_transit_active = false
    group debug_retreat_transit_group = CreateGroup()
    location debug_retreat_origin = Location(0,0)
#ELSE

function DebugStartRetreatTransitTracking takes nothing returns nothing
  local group g = CreateGroup()
  local unit u = null
  local location ul = null
  local real dist_fight = 0
  local real dist_home = 0

  set debug_retreat_transit_id = debug_retreat_transit_id + 1
  set debug_retreat_transit_active = true
  call GroupClear(debug_retreat_transit_group)

  if enemy_loc != null and (GetLocationX(enemy_loc) != 0 or GetLocationY(enemy_loc) != 0) then
    call MoveLocation(debug_retreat_origin, GetLocationX(enemy_loc), GetLocationY(enemy_loc))
  elseif main_army >= 0 and army_loc[main_army] != null then
    call MoveLocation(debug_retreat_origin, GetLocationX(army_loc[main_army]), GetLocationY(army_loc[main_army]))
  else
    call MoveLocation(debug_retreat_origin, GetLocationX(captain_home), GetLocationY(captain_home))
  endif

  call TraceAll("DBG RETREAT TRANSIT START: rid=" + Int2Str(debug_retreat_transit_id) + " captain=" + Int2Str(CaptainGroupSize()) + " originX=" + Int2Str(R2I(GetLocationX(debug_retreat_origin))) + " originY=" + Int2Str(R2I(GetLocationY(debug_retreat_origin))))

  call GroupEnumUnitsOfPlayer(g, ai_player, null)

  loop
    set u = FirstOfGroup(g)
    exitwhen u == null

    if UnitAlive(u) and not IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) then
      set ul = GetUnitLoc(u)
      set dist_fight = DistanceBetweenPoints(ul, debug_retreat_origin)
      set dist_home = DistanceBetweenPoints(ul, captain_home)

      if dist_fight >= 1000 then
        call GroupAddUnit(debug_retreat_transit_group, u)
        call TraceAll("DBG RETREAT TRANSIT SNAP: rid=" + Int2Str(debug_retreat_transit_id) + " id=" + Int2Str(GetHandleId(u)) + " type=" + Int2Str(GetUnitTypeId(u)) + " distFight=" + Int2Str(R2I(dist_fight)) + " distHome=" + Int2Str(R2I(dist_home)) + " order=" + Int2Str(GetUnitCurrentOrder(u)) + " army=" + Int2Str(GetArmyOfUnit(u)) + " standard=" + B2S(IsStandardUnit(u)) + " inRetreat=" + B2S(IsUnitInGroup(u, in_retreat_group)) + " reset=" + B2S(IsUnitInGroup(u, retreat_reset_pending)))
      endif

      call RemoveLocation(ul)
      set ul = null
    endif

    call GroupRemoveUnit(g, u)
  endloop

  call DestroyGroup(g)
  set g = null
  set u = null
endfunction

function DebugTraceRetreatTransitState takes string phase returns nothing
  local group g = null
  local unit u = null
  local location ul = null

  if not debug_retreat_transit_active then
    return
  endif

  set g = CopyGroup(debug_retreat_transit_group)

  loop
    set u = FirstOfGroup(g)
    exitwhen u == null

    if UnitAlive(u) then
      set ul = GetUnitLoc(u)
      call TraceAll("DBG RETREAT TRANSIT: rid=" + Int2Str(debug_retreat_transit_id) + " phase=" + phase + " id=" + Int2Str(GetHandleId(u)) + " distFight=" + Int2Str(R2I(DistanceBetweenPoints(ul, debug_retreat_origin))) + " distHome=" + Int2Str(R2I(DistanceBetweenPoints(ul, captain_home))) + " order=" + Int2Str(GetUnitCurrentOrder(u)) + " army=" + Int2Str(GetArmyOfUnit(u)) + " standard=" + B2S(IsStandardUnit(u)) + " inRetreat=" + B2S(IsUnitInGroup(u, in_retreat_group)) + " reset=" + B2S(IsUnitInGroup(u, retreat_reset_pending)))
      call RemoveLocation(ul)
      set ul = null
    else
      call TraceAll("DBG RETREAT TRANSIT DEAD: rid=" + Int2Str(debug_retreat_transit_id) + " id=" + Int2Str(GetHandleId(u)))
      call GroupRemoveUnit(debug_retreat_transit_group, u)
    endif

    call GroupRemoveUnit(g, u)
  endloop

  call DestroyGroup(g)
  set g = null
  set u = null
endfunction

//============================================================================
// Retreat Control Job //Updated by Strategy Master 26/07/05
//============================================================================
//
function RetreatControlJob takes nothing returns nothing
  local group g = null
  local real ally_sum = 0
  local real enemy_sum = 0
  local real creep_sum = 0
  local unit u = null
  local real unit_strength = 0
  local real unit_life = 0
  local real unit_mana = 0
  //local group g_battle = CreateGroup()
  local real enemy_ranged_strength = 0
  local real ally_ranged_strength = 0
  local integer num_units = 0
  local real ally_strength = 0
  local real enemy_strength = 0
  local real xa = 0
  local real ya = 0
  local real xe = 0
  local real ye = 0
  local integer i = 0

  // local variables used to calculate roughly where the current enemy army is located at
  local integer ally_count = 0
  local integer enemy_count = 0
  local boolean usearmy = true
  local real debug_local_own_sum = 0
  local integer debug_local_own_count = 0
  local real debug_cached_main_strength = -1
  local integer debug_run_id = 0
  local integer debug_start_epoch = 0

  set debug_retreat_run_seq = debug_retreat_run_seq + 1
  set debug_run_id = debug_retreat_run_seq
  set debug_start_epoch = debug_retreat_epoch

  if canflee or isfleeing then
    call TraceAll("DBG RC ENTER:"      + " run=" + Int2Str(debug_run_id)      + " epoch=" + Int2Str(debug_start_epoch)      + " canFlee=" + B2S(canflee)      + " fleeing=" + B2S(isfleeing)      + " retreatCtl=" + B2S(retreat_controlled)      + " captainRetreating=" + B2S(CaptainRetreating()))
  endif

  call DisplayToAllJobDebug("RETREAT_CONTROL JOB Start")

  if major_hero == null or not UnitAlive(major_hero) then
    set major_hero = GetMajorHeroReplacement_k(major_hero,last_major_hero_loc)
  endif

	//   call GroupEnumUnitsInRange(g_battle,GetUnitX(major_hero),GetUnitY(major_hero),battle_radius,null)
	//loop
	//  	set u = FirstOfGroup(g_battle)
	//	exitwhen u == null
	//	if UnitAlive(u) and IsPlayerAlly(GetOwningPlayer(u), ai_player) and IsUnitType(u, UNIT_TYPE_RANGED_ATTACKER) then
	//		set ally_ranged_strength = ally_ranged_strength + GetUnitStrength(u)
	//	else
	//		if UnitAlive(u) and IsPlayerEnemy(GetOwningPlayer(u),ai_player) and IsUnitType(u, UNIT_TYPE_RANGED_ATTACKER) then
	//			set enemy_ranged_strength = enemy_ranged_strength + GetUnitStrength(u)
	//			set num_units = num_units + 1
	//		endif
	//	endif
	//	if UnitAlive(u) and IsPlayerAlly(GetOwningPlayer(u), ai_player) then
	//		set ally_strength = ally_strength + GetUnitStrength(u)
	//	else
	//		if UnitAlive(u) and IsPlayerEnemy(GetOwningPlayer(u),ai_player) then
	//			set enemy_strength = enemy_strength + GetUnitStrength(u)
	//		endif
	//	endif
	//	call GroupRemoveUnit(g_battle,u)
	//endloop
	//call DestroyGroup(g_battle)
	//set g = null

//  if attack_running then
//	if (not (major_hero != null and UnitAlive(major_hero)) and ver_heroes) or CaptainRetreating() or (ally_strength * 3) < enemy_strength then
//		call DisplayToAll("Retreat control ended")
//  		set break_attack = true
//   		set retreat_controlled = false
//		call SetGroupsFlee(true)
//		return
//	endif
//	if not disableretreat then
//		if enemy_ranged_strength > 0 and num_units >= 3 and (ally_strength * 3) < enemy_ranged_strength then
//			call SetUnitsFlee(false)
//		else
//			call SetUnitsFlee(true)
//		endif
//	else
//		// This is if flee control is turned off as the inbuilt unit flee does not help in low hp race mods
//		call SetUnitsFlee(false)
//		call SetHeroesFlee(false)
//	endif
//  else
//	if (not (major_hero != null and UnitAlive(major_hero)) and ver_heroes) or CaptainRetreating() or (ally_strength * 3) < enemy_strength  then
//		call DisplayToAll("Retreat control ended")
//  		set break_attack = false
//    		set retreat_controlled = false
//		call SetGroupsFlee(true)
//		return
//	endif
//      if disableretreat then
//		call SetUnitsFlee(false)
//		call SetHeroesFlee(false)
//	endif
//  endif

if not retreat_controlled then
  return
endif

if not isfleeing and canflee and (CaptainRetreating() or CaptainIsHome()) then
  if ordinary_creep_attack_running then
    call TraceAll("DBG CREEP NATURAL FLEE: id=" + Int2Str(creep_debug_id))
  endif
  call TraceAll("RETREAT_CONTROL: Natural Flee !!!")
  call TraceAll(    "DBG FLEE WRITE:"    + " run=" + Int2Str(debug_run_id)    + " reason=NATURAL"    + " old=false new=true"    + " epoch=" + Int2Str(debug_retreat_epoch)    + " retreatCtl=" + B2S(retreat_controlled)    + " captainRetreating=" + B2S(CaptainRetreating())    + " captainHome=" + B2S(CaptainIsHome()))
  if not debug_retreat_transit_active then
    call DebugStartRetreatTransitTracking()
  endif
  set isfleeing = true
endif

if isfleeing then
  if not debug_retreat_transit_active then
    call DebugStartRetreatTransitTracking()
  endif
  call DebugTraceRetreatTransitState("RC")
endif

if ((not attack_running and not isfleeing) or isfleeing or (town_threatened and town_threat_break) or player_defeated) then
    set break_attack = attack_running
    call TraceAll("RETREAT: Pending End fleeing:" + B2S(isfleeing))
    if CaptainIsHome() or retreat_end_switch or (not attack_running and not isfleeing) or player_defeated or (main_army >= 0 and DistanceBetweenPoints(army_loc[main_army], captain_home) <= 750) then
      call TraceAll("===Retreat control ended===")
      call TraceAll("DBG RETREAT END: captain=" + Int2Str(CaptainGroupSize()) + " break=" + B2S(break_attack) + " desperation=" + B2S(desperation_assault) + " attackRunning=" + B2S(attack_running) + " captainHome=" + B2S(CaptainIsHome()) + " captainRetreating=" + B2S(CaptainRetreating()) + " pendingReset=" + Int2Str(BlzGroupGetSize(retreat_reset_pending)))
      call DebugTraceRetreatTransitState("END")
      set debug_retreat_transit_active = false

      set retreat_controlled = false
      set debug_retreat_epoch = debug_retreat_epoch + 1
      set canflee = false
      if isfleeing then
        call TraceAll(          "DBG FLEE WRITE:"          + " run=" + Int2Str(debug_run_id)          + " reason=RETREAT_END"          + " old=true new=false"          + " epoch=" + Int2Str(debug_retreat_epoch))
      endif
      set isfleeing = false     // home so no need to be retreating. Also prevents bug in the captainretreating condition
      set retreat_end_switch = false
      call SetGroupsFlee(false)
      call TraceAll(        "DBG RC DISABLE:"        + " run=" + Int2Str(debug_run_id)        + " epoch=" + Int2Str(debug_retreat_epoch)        + " fleeing=" + B2S(isfleeing)        + " canFlee=" + B2S(canflee))
      return
    else
      call SetGroupsFlee(true)
    endif
endif

if isfleeing or (town_threatened and town_threat_break) then
    // Force all attacking units (non-harvesters) to drop guard orders and go home
    call TraceAll("Retreat Home Fix")
    set g = CreateGroup()
    call GroupEnumUnitsOfPlayer(g, ai_player, null)
    set g = SelectUnittype(g, UNIT_TYPE_STRUCTURE, false)
    set g = SelectByHidden(g, false)
    set g = SelectByAlive(g, true)
    // send non-harvesting combat units home and remove guard positions
    set num_units = 0
    loop
      set u = FirstOfGroup(g)
      exitwhen u == null
      // Only send standard (combat) units, skip peons/structures/heroes and units in healing/rescue groups
      if IsStandardUnit(u) and not IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitType(u, UNIT_TYPE_STRUCTURE) and DistanceBetweenPoints(GetUnitLoc(u), captain_home) >= 650 then
        if GetUnitCurrentOrder(u) != OrderId("harvest") then
          // track retreating units so we don't re-add them
          if not IsUnitInGroup(u, in_retreat_group) and not IsUnitInGroup(u, retreat_reset_pending) then
            call RemoveGuardPosition(u)
            call GroupAddUnit(in_retreat_group, u)

            // use p==1 to indicate forced retreat in SEND_HOME
            call TQAddUnitJob(0, SEND_HOME, 1, u)
          endif
          set num_units = num_units + 1
        endif
      endif
      call GroupRemoveUnit(g,u)
    endloop
    call DestroyGroup(g)
    set g = null
    if num_units <= 1 then // Most units are home
      set retreat_end_switch = true
    else
      set retreat_end_switch = false
    endif
endif

if isfleeing then
  call TQAddJob(2 * sleep_multiplier, RETREAT_CONTROL, 0)
  return
endif

call GroupClear(debug_flee_candidate_group)

if attack_running then

  set g = CreateGroup()
  if main_army == -1 or army_loc[main_army] == null or (GetLocationX(army_loc[main_army]) == 0 and GetLocationY(army_loc[main_army]) == 0 )then
    if major_hero == null or not UnitAlive(major_hero) then
      call Trace("No major hero in retreat control")
    else
      call GroupEnumUnitsInRange(g,GetUnitX(major_hero),GetUnitY(major_hero),battle_radius,null)
    endif
    set usearmy = false
  else
    call GroupEnumUnitsInRange(g, GetLocationX(army_loc[main_army]), GetLocationY(army_loc[main_army]), battle_radius, null)
    set usearmy = true
    set debug_cached_main_strength = army_strength[main_army]
    set ally_sum = ally_sum + army_strength[main_army]
  endif
  set g = SelectUnittype(g, UNIT_TYPE_STRUCTURE, false)
  set g = SelectByHidden(g, false)
  set g = SelectByAlive(g, true)
  call MoveLocation(last_enemy_loc, GetLocationX(enemy_loc), GetLocationY(enemy_loc))
  call MoveLocation(last_ally_loc, GetLocationX(ally_loc), GetLocationY(ally_loc))

  loop
    set u = FirstOfGroup(g)
    exitwhen u == null  
    set unit_strength = GetUnitStrength(u)

    // Diagnostic only: actual own combat strength physically inside battle_radius.
    if GetOwningPlayer(u) == ai_player and not IsUnitType(u, UNIT_TYPE_PEON) and not IsUnitInGroup(u, unit_healing) and not IsRetreatUnavailableForAttack(u) then
      set debug_local_own_sum = debug_local_own_sum + unit_strength
      set debug_local_own_count = debug_local_own_count + 1
      call GroupAddUnit(debug_flee_candidate_group, u)
    endif

    if (ModuloInteger(i, 200) == 0) then
      call Sleep(0.1)
      if debug_start_epoch != debug_retreat_epoch or not retreat_controlled then
        call TraceAll(        "DBG RC STALE RESUME:"          + " run=" + Int2Str(debug_run_id)          + " startEpoch=" + Int2Str(debug_start_epoch)          + " currentEpoch=" + Int2Str(debug_retreat_epoch)          + " retreatCtl=" + B2S(retreat_controlled)          + " canFlee=" + B2S(canflee)          + " fleeing=" + B2S(isfleeing))
      endif
    endif
    // set unit_life = GetUnitState(u, UNIT_STATE_LIFE)
    // set unit_mana = GetUnitState(u, UNIT_STATE_MANA)
    if GetOwningPlayer(u) != Player(PLAYER_NEUTRAL_AGGRESSIVE) then
      //call Trace("RETREAT_CONTROL: At least 1 unit detected")
      if IsPlayerAlly(GetOwningPlayer(u), ai_player) and (not usearmy or (usearmy and ai_player != GetOwningPlayer(u))) then
        //if GetUnitUserData(u) != UNIT_GOING_HOME then 
        if not IsUnitInGroup(u, unit_healing) then //and unit_life > RMax(flee_health_percentage * GetUnitState(u, UNIT_STATE_MAX_LIFE), flee_minimum_health) then
          set ally_sum = ally_sum + unit_strength
        endif
        set xa = xa + GetUnitX(u)  // Prevent loc exceeding map range
        set ya = ya + GetUnitY(u)
        //set ally_loc = GetSumLoc_dd(ally_loc, GetUnitLoc(u))
        set ally_count = ally_count + 1
      elseif IsPlayerEnemy(GetOwningPlayer(u), ai_player) and not IsUnitInvisibleAM(u, ai_player) then
        set enemy_sum = enemy_sum + unit_strength
        set xe = xe + GetUnitX(u)
        set ye = ye + GetUnitY(u)
        //set enemy_loc = GetSumLoc_dd(enemy_loc, GetUnitLoc(u))
        set enemy_count = enemy_count + 1
      endif
    elseif GetOwningPlayer(u) == Player(PLAYER_NEUTRAL_AGGRESSIVE) and not IsUnitInvisibleAM(u, ai_player) and not UnitIsSleeping(u) and IsUnitVisible(u, ai_player) then
      // set unit_life = GetUnitState(u, UNIT_STATE_LIFE)
      // set unit_mana = GetUnitState(u, UNIT_STATE_MANA)
      set creep_sum = creep_sum + unit_strength
    endif
    call GroupRemoveUnit(g,u)
    set i = i + 1
  endloop
  call DestroyGroup(g)
  set g = null
  
  // Ancient tree army bonuses
  if ancient_expanding and ancient_attack_running then 
    set ally_sum = ally_sum + 7
  endif
  
  if br_rush_attacked then
    set ally_sum = ally_sum + 5
  endif  

  set xe = xe / I2R(Max(enemy_count, 1))
  set ye = ye / I2R(Max(enemy_count, 1))
  set xa = xa / I2R(Max(ally_count, 1))
  set ya = ya / I2R(Max(ally_count, 1))
  call MoveLocation(enemy_loc, xe, ye)
  //call MoveLocation(ally_loc, xa, ya)
  //set enemy_loc = GetDivisionLoc_d(enemy_loc, I2R(Max(enemy_count, 1)))
  //set ally_loc = GetDivisionLoc_d(ally_loc, I2R(Max(ally_count, 1)))
  //  call SetCaptainHome(0, GetLocationX(ally_loc), GetLocationY(ally_loc))

  set enemy_strength_sum = enemy_sum + creep_sum
  set ally_strength_sum = ally_sum

  if ordinary_creep_attack_running and (enemy_strength_sum > 0 or CaptainInCombat(true) or CaptainRetreating()) then
    call TraceAll("DBG CREEP RC: id=" + Int2Str(creep_debug_id) + " ownUsed=" + Int2Str(R2I(ally_strength_sum)) + " cachedMain=" + Int2Str(R2I(debug_cached_main_strength)) + " localOwn=" + Int2Str(R2I(debug_local_own_sum)) + " localUnits=" + Int2Str(debug_local_own_count) + " enemyPlusCreeps=" + Int2Str(R2I(enemy_strength_sum)) + " radius=" + Int2Str(R2I(battle_radius)) + " combat=" + B2S(CaptainInCombat(true)) + " retreating=" + B2S(CaptainRetreating()) + " canFlee=" + B2S(canflee))
  endif
  call Trace("RETREAT_CONTROL: Our strength: " + Real2Str(ally_strength_sum) + " Enemy strength: " + Real2Str(enemy_strength_sum))

  if CaptainInCombat(true) and not desperation_assault and (enemy_strength_sum > ApplyFleeStrengthModifier(ally_strength_sum, true) or (town_threatened and town_threat_break and attack_running) or ally_strength_sum == 0) then
    if ordinary_creep_attack_running then
      call TraceAll("DBG CREEP FORCED FLEE: id=" + Int2Str(creep_debug_id) + " own=" + Int2Str(R2I(ally_strength_sum)) + " enemy=" + Int2Str(R2I(enemy_strength_sum)))
    endif
    call TraceAll("RETREAT_CONTROL: Flee!!!!")
    set break_attack = attack_running

    if not debug_retreat_transit_active then
      call DebugStartRetreatTransitTracking()
    endif

    call CaptainGoHome()
    if not isfleeing then
      call TraceAll(        "DBG FLEE WRITE:"        + " run=" + Int2Str(debug_run_id)        + " reason=FORCED"        + " old=false new=true"        + " epoch=" + Int2Str(debug_retreat_epoch)        + " retreatCtl=" + B2S(retreat_controlled)        + " captainRetreating=" + B2S(CaptainRetreating()))
    endif
    set isfleeing = true
  elseif CaptainInCombat(true) and not desperation_assault and (enemy_strength_sum > ApplyFleeStrengthModifier(ally_strength_sum, false) or (battle_radius == creep_battle_radius and enemy_strength_sum > ally_strength_sum )) then
    if ordinary_creep_attack_running then
     call TraceAll("DBG CREEP ALLOWED FLEE: id=" + Int2Str(creep_debug_id) + " own=" + Int2Str(R2I(ally_strength_sum)) + " enemy=" + Int2Str(R2I(enemy_strength_sum)))
    endif
    call TraceAll("RETREAT_CONTROL: Allowed to Flee")
    if not canflee then
      call TraceAll("DBG FLEE ALLOW START:"        + " run=" + Int2Str(debug_run_id)        + " own=" + Int2Str(R2I(ally_strength_sum))        + " enemy=" + Int2Str(R2I(enemy_strength_sum))        + " localOwn=" + Int2Str(R2I(debug_local_own_sum))        + " localUnits=" + Int2Str(debug_local_own_count)        + " captain=" + Int2Str(CaptainGroupSize())        + " combat=" + B2S(CaptainInCombat(true))        + " retreating=" + B2S(CaptainRetreating()))
    endif
    call SetGroupsFlee(true)
    set canflee = true
  else
    if canflee then
      call TraceAll(    "DBG FLEE ALLOW CANCEL:"    + " run=" + Int2Str(debug_run_id)    + " own=" + Int2Str(R2I(ally_strength_sum))    + " enemy=" + Int2Str(R2I(enemy_strength_sum))    + " captain=" + Int2Str(CaptainGroupSize())    + " combat=" + B2S(CaptainInCombat(true))    + " retreating=" + B2S(CaptainRetreating()))
    endif
    call SetGroupsFlee(false) // Prevent natural fleeing
    if isfleeing then
      call TraceAll(        "DBG FLEE WRITE:"        + " run=" + Int2Str(debug_run_id)        + " reason=NO_FLEE"        + " old=true new=false"        + " epoch=" + Int2Str(debug_retreat_epoch)        + " retreatCtl=" + B2S(retreat_controlled))
    endif
    set isfleeing = false
    set canflee = false
  endif
  
endif  

  call TQAddJob(2 * sleep_multiplier, RETREAT_CONTROL, 0)
endfunction
#ENDIF
