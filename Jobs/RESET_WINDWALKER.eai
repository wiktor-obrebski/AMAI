#IFDEF GLOBAL
#ELSE
function ResetWindWalkerGuardPosition takes unit u returns nothing
  call DisplayToAllJobDebug("RESET_GUARD_POSITION JOB START")
  call CreateDebugTag("RECYCLE Windwalk", 10, u, 3.00, 1.50)
  if IsUnitVisible(u, Player(PLAYER_NEUTRAL_AGGRESSIVE)) and IsStandardUnit(u) then
    call RecycleGuardPositionAM(u)
    if attack_running and not isfleeing then
        call DebugHeroAddAssault(1, GetUnitTypeId(u), "Jobs/RESET_WINDWALKER.eai:ResetWindWalkerGuardPosition:9")
    endif
  endif
endfunction
#ENDIF