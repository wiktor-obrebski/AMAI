#IFDEF GLOBAL
#ELSE

function SendHomeMoveUnitToLoc takes unit u, location l returns nothing
	local integer enemystrength = GetLocationNonCreepStrength(GetUnitX(u), GetUnitY(u), 800)
	if GetUnitAbilityLevel(u, 'AOwk') > 0 or GetUnitAbilityLevel(u, 'ANwk') > 0 then
		if enemystrength > 0 and not IsUnitInvisibleAM(u, Player(PLAYER_NEUTRAL_AGGRESSIVE)) then
			call DebugHeroIssueImmediateOrder(u, "windwalk", "Jobs/SEND_HOME.eai:SendHomeMoveUnitToLoc:8")
		endif
	endif
	if enemystrength > 0 and ((GetUnitState(u, UNIT_STATE_MANA) > 50 and GetUnitAbilityLevel(u, 'AEbl') == 1) or (GetUnitState(u, UNIT_STATE_MANA) > 10 and GetUnitAbilityLevel(u, 'AEbl') > 1)) then
		call DebugHeroIssuePointOrder(u, "blink", GetLocationX(l), GetLocationY(l), "Jobs/SEND_HOME.eai:SendHomeMoveUnitToLoc:12")
		call DebugHeroIssuePointOrder(u, "move", GetLocationX(l), GetLocationY(l), "Jobs/SEND_HOME.eai:SendHomeMoveUnitToLoc:13")
	elseif GetUnitAbilityLevel(u, 'Ashm') > 0 and enemystrength > 0 and (GetFloatGameState(GAME_STATE_TIME_OF_DAY) >= 18 or GetFloatGameState(GAME_STATE_TIME_OF_DAY) < 6) and not IsUnitType(u, UNIT_TYPE_HERO) then
		call CreateDebugTag("SEND_HOME: Night Hide", 10, u, 3.00, 1.50)
		call DebugHeroIssueImmediateOrder(u, "ambush", "Jobs/SEND_HOME.eai:SendHomeMoveUnitToLoc:16")
	else
		call CreateDebugTag("SEND_HOME: Moving to Location", 10, u, 3.00, 2.00)
		//call RemoveGuardPosition(u)
		call DebugHeroIssuePointOrder(u, "move", GetLocationX(l), GetLocationY(l), "Jobs/SEND_HOME.eai:SendHomeMoveUnitToLoc:20")
	endif
endfunction

function SomeUnitHasHealingItem takes unit ru, unit u, integer rhi returns unit
	local group g = CreateGroup()
	call GroupEnumUnitsInRange(g, GetUnitX(u), GetUnitY(u), 400, null)
	set g = SelectByPlayer(g,ai_player, true)
	set g = SelectByAlive(g,true)
	loop
		set ru = FirstOfGroup(g)
		exitwhen ru == null
		if GetUnitAbilityLevel(u, 'AInv') > 0 and GetItemNumberOnUnit(rhi, ru) > 0 then
			call DestroyGroup(g)
			set g = null
			return ru
		endif
		call GroupRemoveUnit(g, ru)
	endloop
	call DestroyGroup(g)
	set g = null
	return null
endfunction

function SendUnitHomeJob takes unit u, integer p returns nothing

  local location l = null
  local unit nearshopunit = null 
  local group g = null
  local unit corpse = null
  local integer racial_healing_item = 0
  local integer racial_mana_item = 0
  local integer enemystrength = 0
  local unit otherhero = null
  local item it = null

  call DisplayToAllJobDebug("SEND_HOME Job")

  // A previously queued healing job must not compete with forced retreat.
  if p == 0 and IsRetreatOrderLocked(u) then
    return
  endif

  if GetUnitState(u, UNIT_STATE_LIFE) <= 0 then
    call CreateDebugTag("SEND_HOME unit dead", 10, u, 3.00, 1.50)
    if IsUnitInGroup(u, debug_retreat_transit_group) then
      call TraceAll("DBG RETREAT TRANSIT DEAD SEND_HOME: rid=" + Int2Str(debug_retreat_transit_id) + " id=" + Int2Str(GetHandleId(u)) + " army=" + Int2Str(GetArmyOfUnit(u)))
      call GroupRemoveUnit(debug_retreat_transit_group, u)
    endif
    if p >= 1 then
        call GroupRemoveUnit(in_retreat_group, u)
    endif

    call TQAddUnitJob(2, RESET_GUARD_POSITION, p, u)
    return
  endif
  if p >= 1 and IsRetreatTeleporting(u) then
    call TQAddUnitJob(1, SEND_HOME, p, u)
    return
  endif
  if IsUnitType(u, UNIT_TYPE_HERO) then
    set racial_healing_item = GetHeroHealingItem()
    set racial_mana_item = GetHeroManaItem()
    if racial_healing_item != 0 then
      set otherhero = SomeUnitHasHealingItem(otherhero, u, racial_healing_item)
      if buy_type[racial_healing_item] == BT_RACIAL_ITEM then
        //set shop_unit = GetUnitOfTypeNearUnit(old_id[racial_shop], u, shop_unit)
        set nearshopunit = GetUnitOfTypeNearUnit(old_id[racial_shop], u, nearshopunit)
        //	set shop_distance_limit = raceshop_distance_limit
      else
        //	set shop_unit = nearest_neutral[NEUTRAL_MERCHANT]
        if not (neutral_guarded[NEUTRAL_MERCHANT] and ((GetFloatGameState(GAME_STATE_TIME_OF_DAY) >= 5 and GetFloatGameState(GAME_STATE_TIME_OF_DAY) < 18) or not neutral_night_buy[NEUTRAL_MERCHANT])) then
          set nearshopunit = nearest_neutral[NEUTRAL_MERCHANT]
        endif      
      endif
      //	set shop_distance_limit = merchant_distance_limit
    endif     
    //set shop_sent = u
    //call TQAddJob(0, BUY_ITEM, racial_healing_item)
    //set nearshopunit = shop_unit
  endif

  call DisplayToAllJobDebug("SEND_HOME Starting check")

  call UpdateRecoveryHome()

  // Forced retreat: send unit home regardless of health (p == 1)
  if p >= 1 and DistanceBetweenPoints_dk(GetUnitLoc(u), GetRecoveryHome()) >= 650 then
    //call CreateDebugTag("SEND_HOME: Forced retreat", 10, u, 2.00, 1.50)
    if IsUnitInGroup(u, debug_retreat_transit_group) then
      call TraceAll("DBG RETREAT TRANSIT SEND_HOME: rid=" + Int2Str(debug_retreat_transit_id) + " id=" + Int2Str(GetHandleId(u)) + " distHome=" + Int2Str(R2I(DistanceBetweenPoints_dk(GetUnitLoc(u), GetRecoveryHome()))) + " distFight=" + Int2Str(R2I(DistanceBetweenPoints_dk(GetUnitLoc(u), debug_retreat_origin))) + " order=" + Int2Str(GetUnitCurrentOrder(u)) + " army=" + Int2Str(GetArmyOfUnit(u)))
    endif
    call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:110")
    call SendHomeMoveUnitToLoc(u, GetRecoveryHome())
    call TQAddUnitJob(4, SEND_HOME, p, u)
    return
  elseif p >= 1 then
    call CreateDebugTag("SEND_HOME: Retreated", 10, u, 2.00, 1.50)
    call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:116")
    call DebugHeroIssueImmediateOrder(u, "holdposition", "Jobs/SEND_HOME.eai:SendUnitHomeJob:117")
    call GroupAddUnit(retreat_reset_pending, u)
    call GroupRemoveUnit(in_retreat_group, u)
    if IsUnitInGroup(u, debug_retreat_transit_group) then
      call TraceAll("DBG RETREAT TRANSIT ARRIVED: rid=" + Int2Str(debug_retreat_transit_id) + " id=" + Int2Str(GetHandleId(u)) + " distFight=" + Int2Str(R2I(DistanceBetweenPoints_dk(GetUnitLoc(u), debug_retreat_origin))))
      call GroupRemoveUnit(debug_retreat_transit_group, u)
    endif
    call TraceAll("DBG RETREAT ARRIVED: id=" + Int2Str(GetHandleId(u)) + " type=" + Int2Str(GetUnitTypeId(u)) + " order=" + Int2Str(GetUnitCurrentOrder(u)) + " army=" + Int2Str(GetArmyOfUnit(u)) + " captain=" + Int2Str(CaptainGroupSize()) + " pendingReset=" + Int2Str(BlzGroupGetSize(retreat_reset_pending)) + " attackRunning=" + B2S(attack_running) + " creepRunning=" + B2S(ordinary_creep_attack_running) + " creepId=" + Int2Str(creep_debug_id) + " hero=" + B2S(IsUnitType(u, UNIT_TYPE_HERO)))
    call RetreatRecovery(u)
    call TQAddUnitJob(15, RESET_RETREAT, 0, u)
    return
  endif

  if GetUnitState(u, UNIT_STATE_LIFE) >= GetUnitState(u, UNIT_STATE_MAX_LIFE) * (I2R(60)/100) and GetUnitCurrentOrder(u) != OrderId("cannibalize") then
    call CreateDebugTag("SEND_HOME Healed", 10, u, 3.00, 1.50)	
    call TQAddUnitJob(2, RESET_GUARD_POSITION, 0, u)
  elseif racial_healing_item != 0 and GetItemNumberOnUnit(racial_healing_item, u) > 0 then
    call CreateDebugTag("Hero: Use healing item", 10, u, 3.00, 2.00)
    if GetItemInstantType(racial_healing_item) == ITEMTYPE_CONTINUOUS and DistanceBetweenPoints_dk(GetUnitLoc(u), GetRecoveryHome()) >= 1200 then
      call SendHomeMoveUnitToLoc(u,GetRecoveryHome())  // This should be required for all regenerative type healing items
      call TQAddUnitJob(4, SEND_HOME, p, u)
    else
      call CreateDebugTag("Hero: Use healing item", 10, u, 3.00, 1.50)
      set it = GetItemOfTypeOnUnit(racial_healing_item, u)
      call DebugHeroUnitUseItem(u, it, "Jobs/SEND_HOME.eai:SendUnitHomeJob:141")
      call DebugHeroUnitUseItemTarget(u, it, u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:142")
      if racial_mana_item != 0 and GetUnitState(u, UNIT_STATE_MANA) < 100 and GetItemNumberOnUnit(racial_mana_item, u) > 0 then
        call DebugHeroUnitUseItem(u, GetItemOfTypeOnUnit(racial_mana_item, u), "Jobs/SEND_HOME.eai:SendUnitHomeJob:144")
      endif
      call TQAddUnitJob(Max(3,GetItemHealingTime(racial_healing_item)), SEND_HOME, p, u) // Have to add delay as continous healing items run out
      set it = null
    endif
  elseif otherhero != null and IsUnitType(u, UNIT_TYPE_HERO) then
      if GetSlotsFreeOnUnit(u) > 0 then  // prevent create on the ground
        call UnitAddItem(u, GetItemOfTypeOnUnit(racial_healing_item, otherhero))
        call TQAddUnitJob(2, RESET_GUARD_POSITION, 0, u)
      else
        call TQAddUnitJob(4, SEND_HOME, p, u)
      endif
  elseif nearshopunit != null and IsUnitType(u, UNIT_TYPE_HERO) and GetSlotsFreeOnUnit(u) > 0 and GetItemNumberOnUnit(racial_healing_item, u) <= 0 then
      if DistanceBetweenUnits(u, nearshopunit) >= buy_distance then
        set l = GetUnitLoc(nearshopunit)
        call SendHomeMoveUnitToLoc(u,l)
        call RemoveLocation(l)
        set l = null
        call TQAddUnitJob(4, SEND_HOME, p, u)
      else
        call CreateDebugTag("SEND_HOME Stop at Shop", 10, u, 3.00, 2.00)	
        call DebugHeroIssueImmediateOrder(u, "holdposition", "Jobs/SEND_HOME.eai:SendUnitHomeJob:165") // use hold position as stop will cancel panda clones for the hero (and possibly other special abilities)
        call IssueNeutralImmediateOrderById(ai_player, nearshopunit, old_id[racial_healing_item])
        if GetUnitState(u, UNIT_STATE_MANA) < 100 and racial_mana_item != 0 and GetItemNumberOnUnit(racial_mana_item, u) <= 0 then
          call IssueNeutralImmediateOrderById(ai_player, nearshopunit, old_id[racial_mana_item])
        endif
        call TQAddUnitJob(2, RESET_GUARD_POSITION, 0, u)  // end job
      endif
  else
      if DistanceBetweenPoints_dk(GetUnitLoc(u), GetRecoveryHome()) >= 1200 then
       call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:174")  // prevent town_threatened give control , but not restore , causing hesitation
       call SendHomeMoveUnitToLoc(u,GetRecoveryHome())
       if follow_zeppelin != null and not IsUnitInGroup(follow_zeppelin, unit_rescueing) and not IsUnitType(u, UNIT_TYPE_FLYING) then
         call CreateDebugTag("Zepplin Home", 10, u, 3.00, 1.50)
         call GroupAddUnit(unit_rescueing, follow_zeppelin)
         set g = CreateGroup()
         call GroupAddUnit(g, follow_zeppelin)
         call GroupAddUnit(unit_healing, u)
         call TQAddGroupJob(0, ZEPPELIN_MOVE, ZTARGET_HOME, u, g)
         // switch job
         return
       endif
      else
        if town_threatened and GetLocationNonCreepStrength(GetUnitX(u), GetUnitY(u), 1500) > 0 then  // only need to control the unit if it is attacked nearby, otherwise will be killed
          call CreateDebugTag("SEND_HOME town_threatened", 10, u, 3.00, 1.50)
          call RecycleGuardPositionAM(u)   // Gives unit control for only a little bit but dosn't remove from healing group
        elseif GetUnitAbilityLevel(u, 'Ashm') > 0 and (GetFloatGameState(GAME_STATE_TIME_OF_DAY) >= 18 or GetFloatGameState(GAME_STATE_TIME_OF_DAY) < 6) and not IsUnitType(u, UNIT_TYPE_HERO) then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:191")
          call DebugHeroIssueImmediateOrder(u, "ambush", "Jobs/SEND_HOME.eai:SendUnitHomeJob:192")
          call CreateDebugTag("SEND_HOME hide", 10, u, 3.00, 1.50)
        elseif GetUnitAbilityLevel(u, 'Abur') > 0 and not IsUnitInvisibleAM(u, Player(PLAYER_NEUTRAL_AGGRESSIVE)) then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:195")
          call DebugHeroIssueImmediateOrder(u, "burrow", "Jobs/SEND_HOME.eai:SendUnitHomeJob:196")
          call CreateDebugTag("SEND_HOME burrow", 10, u, 3.00, 1.50)
        elseif GetUnitAbilityLevel(u, 'Astn') > 0 and GetUnitAbilityLevel(u, 'ACmi') == 0 then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:199")
          call DebugHeroIssueImmediateOrder(u, "stoneform", "Jobs/SEND_HOME.eai:SendUnitHomeJob:200")
          call CreateDebugTag("SEND_HOME stone", 10, u, 3.00, 1.50)  
        elseif GetUnitCurrentOrder(u) != OrderId("cannibalize") and (GetUnitAbilityLevel(u, 'Acn2') > 0 or GetUnitAbilityLevel(u, 'Acan') > 0 or GetUnitAbilityLevel(u, 'ACcn') > 0) then
          set g = CreateGroup()
          call GroupEnumUnitsInRangeOfLoc(g, GetRecoveryHome(), 1000, null)
          loop
              set corpse = FirstOfGroup(g)
              exitwhen corpse == null
              exitwhen not UnitAlive(corpse) and IsUnitType(corpse, UNIT_TYPE_DEAD) and not IsUnitType(corpse, UNIT_TYPE_STRUCTURE)
              call GroupRemoveUnit(g, corpse)
          endloop
          call DestroyGroup(g)
          set g = null
          if corpse != null then
            call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:214")
            call DebugHeroIssueTargetOrder(u, "move" , corpse, "Jobs/SEND_HOME.eai:SendUnitHomeJob:215")
            call DebugHeroIssueImmediateOrder(u, "cannibalize", "Jobs/SEND_HOME.eai:SendUnitHomeJob:216")
            call CreateDebugTag("SEND_HOME cannibalize", 10, u, 3.00, 1.50)
            set corpse = null
          else
            set g = CreateGroup()
            call GroupEnumUnitsInRangeOfLoc(g, GetRecoveryHome(), 1000, null)
            loop
                set corpse = FirstOfGroup(g) // Not a corpse, is it a town hall we can return wood too?
                exitwhen corpse == null
                exitwhen UnitAlive(corpse) and IsUnitType(corpse, UNIT_TYPE_TOWNHALL)
                call GroupRemoveUnit(g, corpse)
            endloop
            if corpse != null and GetUnitAbilityLevel(u, 'Ahrl') > 0 and GetUnitCurrentOrder(u) != OrderId("cannibalize") then   // 'Ahrl' Ghoul Harvest lumber ability
              call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:229")
              if GetUnitCurrentOrder(u) == OrderId("harvest") or GetUnitCurrentOrder(u) == OrderId("resumeharvesting") then
              else
                call DebugHeroIssueImmediateOrder(u, "autoharvestlumber", "Jobs/SEND_HOME.eai:SendUnitHomeJob:232")
              endif
              call CreateDebugTag("SEND_HOME harvest lumber", 10, u, 3.00, 1.50)
            endif
            set corpse = null
            call DestroyGroup(g)
            set g = null
          endif
          // Below attempt to heal myself
        elseif (GetUnitAbilityLevel(u, 'Ahwd') > 0 or GetUnitAbilityLevel(u, 'AChw') > 0) and not ward_cast then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:242")
          call DebugHeroIssuePointOrder(u, "healingward", GetUnitX(u), GetUnitY(u), "Jobs/SEND_HOME.eai:SendUnitHomeJob:243")
          call CreateDebugTag("SEND_HOME use healingward " + B2S(ward_cast), 10, u, 3.00, 1.50)
        elseif GetUnitAbilityLevel(u, 'AChv') > 0 or (IsUnitType(u, UNIT_TYPE_HERO) and (GetUnitAbilityLevel(u, 'AOhw') > 0 or GetUnitAbilityLevel(u, 'ANhw') > 0)) then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:246")
          call DebugHeroIssueTargetOrder(u, "healingwave", u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:247")
          call CreateDebugTag("SEND_HOME heal wave", 10, u, 3.00, 1.50)
        elseif GetUnitAbilityLevel(u, 'ANhs') > 0 then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:250")
          call DebugHeroIssuePointOrder(u, "healingspray", GetUnitX(u), GetUnitY(u), "Jobs/SEND_HOME.eai:SendUnitHomeJob:251")
          call CreateDebugTag("SEND_HOME heal spray", 10, u, 3.00, 1.50)
        elseif GetUnitAbilityLevel(u, 'Abrf') > 0 or GetUnitAbilityLevel(u, 'Arej') > 0 or GetUnitAbilityLevel(u, 'ACrj') > 0 or GetUnitAbilityLevel(u, 'ACr2') > 0 then
          call DebugHeroRemoveGuardPosition(u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:254")
          if GetUnitAbilityLevel(u, 'Abrf') > 0 then
            call DebugHeroIssueImmediateOrder(u, "unbearform", "Jobs/SEND_HOME.eai:SendUnitHomeJob:256")
          endif
          call DebugHeroIssueTargetOrder(u, "rejuvination", u, "Jobs/SEND_HOME.eai:SendUnitHomeJob:258")
        endif
      endif
      call TQAddUnitJob(4, SEND_HOME, p, u)
      //call DisplayToAllJobDebug("SEND_HOME: JOB Finished!!!! ")
  endif
  set nearshopunit = null
  set otherhero = null
  set corpse = null
endfunction
#ENDIF
