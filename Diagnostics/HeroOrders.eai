function DebugHeroControlSample takes integer controlCall, string phase, unit focus returns nothing
  local integer slot = 1
  local boolean focusSeen = false
  loop
    exitwhen slot > 3
    if hero_unit[slot] != null then
      call DebugHeroLog("HERO CONTROL STATE: call=" + Int2Str(controlCall) + " phase=" + phase + DebugHeroState(hero_unit[slot]))
      if hero_unit[slot] == focus then
        set focusSeen = true
      endif
    endif
    set slot = slot + 1
  endloop
  if focus != null and not focusSeen then
    call DebugHeroLog("HERO CONTROL STATE: call=" + Int2Str(controlCall) + " phase=" + phase + DebugHeroState(focus))
  endif
endfunction

function DebugHeroControlBefore takes string source, string action, string details, unit focus returns integer
  if not debug_hero_tracking then
    return 0
  endif
  set debug_hero_control_call = debug_hero_control_call + 1
  call DebugHeroLog("HERO CONTROL: phase=BEFORE call=" + Int2Str(debug_hero_control_call) + " source=" + source + " action=" + action + details + " operation=" + Int2Str(debug_attack_operation) + " command=" + Int2Str(debug_attack_command) + " attack=" + B2S(attack_running) + " fleeing=" + B2S(isfleeing) + " retreatCtl=" + B2S(retreat_controlled) + " captainSize=" + Int2Str(CaptainGroupSize()) + " captainRetreating=" + B2S(CaptainRetreating()))
  call DebugHeroControlSample(debug_hero_control_call, "BEFORE", focus)
  return debug_hero_control_call
endfunction

function DebugHeroControlAfter takes integer controlCall, unit focus, string result returns nothing
  if controlCall == 0 then
    return
  endif
  call DebugHeroControlSample(controlCall, "AFTER", focus)
  call DebugHeroLog("HERO CONTROL: phase=AFTER call=" + Int2Str(controlCall) + result + " captainSize=" + Int2Str(CaptainGroupSize()) + " captainRetreating=" + B2S(CaptainRetreating()))
endfunction

function DebugHeroRemoveGuardPosition takes unit u, string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking and u != null and IsUnitType(u, UNIT_TYPE_HERO) then
    set controlCall = DebugHeroControlBefore(source, "RemoveGuardPosition", " unit=" + Int2Str(GetHandleId(u)), u)
  endif
  call RemoveGuardPosition(u)
  call DebugHeroControlAfter(controlCall, u, "")
endfunction

function DebugHeroRecycleGuardPosition takes unit u, string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking and u != null and IsUnitType(u, UNIT_TYPE_HERO) then
    set controlCall = DebugHeroControlBefore(source, "RecycleGuardPosition", " unit=" + Int2Str(GetHandleId(u)), u)
  endif
  call RecycleGuardPosition(u)
  call DebugHeroControlAfter(controlCall, u, "")
endfunction

function DebugHeroCaptainGoHome takes string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking then
    set controlCall = DebugHeroControlBefore(source, "CaptainGoHome", "", null)
  endif
  call CaptainGoHome()
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroCaptainAttack takes real x, real y, string source returns nothing
