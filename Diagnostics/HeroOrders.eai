// Leaf order writers are tagged explicitly: no shared "current job" across sleeping threads.
function DebugHeroLog takes string s returns nothing
  if not debug_hero_tracking then
    return
  endif
  if debug_hero_cache == null then
    set debug_hero_cache = InitGameCache("AMAI_HeroTrace_P" + Int2Str(GetAiPlayer()) + ".w3v")
    call FlushStoredMission(debug_hero_cache, "P" + Int2Str(GetAiPlayer()))
  endif
  call StoreString(debug_hero_cache, "P" + Int2Str(GetAiPlayer()), "L" + Int2Str(debug_hero_index), "tms=" + Int2Str(R2I(TimerGetElapsed(tq_timer) * 1000)) + " " + s)
  set debug_hero_index = debug_hero_index + 1
  call StoreInteger(debug_hero_cache, "P" + Int2Str(GetAiPlayer()), "Count", debug_hero_index)
  set debug_hero_dirty = true
endfunction

function DebugHeroState takes unit u returns string
  local real homeX = 0
  local real homeY = 0
  local real dx = 0
  local real dy = 0
  if captain_home != null then
    set homeX = GetLocationX(captain_home)
    set homeY = GetLocationY(captain_home)
  endif
  set dx = GetUnitX(u) - homeX
  set dy = GetUnitY(u) - homeY
  return " hero=" + Int2Str(GetHandleId(u)) + " type=" + Int2Str(GetUnitTypeId(u)) + " x=" + Int2Str(R2I(GetUnitX(u))) + " y=" + Int2Str(R2I(GetUnitY(u))) + " hp=" + Int2Str(R2I(GetUnitState(u, UNIT_STATE_LIFE))) + " maxHp=" + Int2Str(R2I(GetUnitState(u, UNIT_STATE_MAX_LIFE))) + " current=" + Int2Str(GetUnitCurrentOrder(u)) + " homeX=" + Int2Str(R2I(homeX)) + " homeY=" + Int2Str(R2I(homeY)) + " distHome=" + Int2Str(R2I(SquareRoot(dx * dx + dy * dy))) + " retreat=" + B2S(IsUnitInGroup(u, in_retreat_group)) + " pending=" + B2S(IsUnitInGroup(u, retreat_reset_pending)) + " healing=" + B2S(IsUnitInGroup(u, unit_healing)) + " rescue=" + B2S(IsUnitInGroup(u, unit_rescueing)) + " harass=" + B2S(IsUnitInGroup(u, unit_harassing)) + " transport=" + B2S(IsUnitInGroup(u, unit_zepplin_move)) + " buying=" + B2S(IsUnitInGroup(u, unit_buying_item)) + " canFlee=" + B2S(canflee) + " fleeing=" + B2S(isfleeing) + " attack=" + B2S(attack_running) + " retreatCtl=" + B2S(retreat_controlled)
endfunction

function DebugHeroOrderBefore takes unit u, string source, string kind, integer order, integer target, real x, real y returns integer
  if not debug_hero_tracking or u == null or not IsUnitType(u, UNIT_TYPE_HERO) then
    return 0
  endif
  set debug_hero_request = debug_hero_request + 1
  call DebugHeroLog("HERO ORDER SOURCE: request=" + Int2Str(debug_hero_request) + " source=" + source + " kind=" + kind + " order=" + Int2Str(order) + " target=" + Int2Str(target) + " tx=" + Int2Str(R2I(x)) + " ty=" + Int2Str(R2I(y)) + DebugHeroState(u))
  return debug_hero_request
endfunction

function DebugHeroOrderAfter takes unit u, integer request, boolean accepted returns nothing
  if request != 0 then
    call DebugHeroLog("HERO ORDER RESULT: request=" + Int2Str(request) + " accepted=" + B2S(accepted) + " hero=" + Int2Str(GetHandleId(u)) + " current=" + Int2Str(GetUnitCurrentOrder(u)))
  endif
endfunction

function DebugHeroIssueImmediateOrder takes unit u, string order, string source returns boolean
  local integer request = 0
  local boolean accepted = false
  if debug_hero_tracking and u != null and IsUnitType(u, UNIT_TYPE_HERO) then
    set request = DebugHeroOrderBefore(u, source, "immediate", OrderId(order), 0, 0, 0)
  endif
  set accepted = IssueImmediateOrder(u, order)
  call DebugHeroOrderAfter(u, request, accepted)
  return accepted
endfunction

function DebugHeroIssueImmediateOrderById takes unit u, integer order, string source returns boolean
