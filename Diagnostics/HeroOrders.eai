  if debug_hero_tracking then
    set controlCall = DebugHeroControlBefore(source, "CaptainAttack", " x=" + Int2Str(R2I(x)) + " y=" + Int2Str(R2I(y)), null)
  endif
  call CaptainAttack(x, y)
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroSetCaptainHome takes integer captain, real x, real y, string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking then
    set controlCall = DebugHeroControlBefore(source, "SetCaptainHome", " captain=" + Int2Str(captain) + " x=" + Int2Str(R2I(x)) + " y=" + Int2Str(R2I(y)), null)
  endif
  call SetCaptainHome(captain, x, y)
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroInitAssault takes string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking then
    set controlCall = DebugHeroControlBefore(source, "InitAssault", "", null)
  endif
  call InitAssault()
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroAddAssault takes integer count, integer unitid, string source returns boolean
  local integer controlCall = 0
  local boolean accepted = false
  if debug_hero_tracking then
    set controlCall = DebugHeroControlBefore(source, "AddAssault", " count=" + Int2Str(count) + " unitid=" + Int2Str(unitid), null)
  endif
  set accepted = AddAssault(count, unitid)
  if controlCall != 0 then
    call DebugHeroControlAfter(controlCall, null, " accepted=" + B2S(accepted))
  endif
  return accepted
endfunction


function DebugHeroAttackState takes string phase, string source returns nothing
  if debug_hero_tracking then
    call DebugHeroLog("ATTACK LIFECYCLE: phase=" + phase + " source=" + source + " operation=" + Int2Str(debug_attack_operation) + " command=" + Int2Str(debug_attack_command) + " attack=" + B2S(attack_running) + " break=" + B2S(break_attack) + " fleeing=" + B2S(isfleeing) + " canFlee=" + B2S(canflee) + " retreatCtl=" + B2S(retreat_controlled) + " captainRetreating=" + B2S(CaptainRetreating()))
  endif
endfunction

function DebugHeroAttackBegin takes string source returns integer
  if debug_hero_tracking then
    set debug_attack_sequence = debug_attack_sequence + 1
    set debug_attack_operation = debug_attack_sequence
    call DebugHeroAttackState("BEGIN", source)
  endif
  return debug_attack_operation
endfunction

function DebugHeroAttackEnd takes integer operation, integer parent, string source returns nothing
  if debug_hero_tracking then
    call DebugHeroLog("ATTACK OPERATION END: operation=" + Int2Str(operation) + " parent=" + Int2Str(parent) + " source=" + source)
    call DebugHeroAttackState("END", source)
    if debug_attack_operation == operation then
      set debug_attack_operation = parent
    endif
  endif
endfunction

function DebugHeroAttackMoveKill takes unit target, string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking then
    set debug_attack_command = debug_attack_command + 1
    call DebugHeroLog("ATTACK COMMAND: operation=" + Int2Str(debug_attack_operation) + " command=" + Int2Str(debug_attack_command) + " source=" + source + " kind=unit target=" + Int2Str(GetHandleId(target)) + " x=" + Int2Str(R2I(GetUnitX(target))) + " y=" + Int2Str(R2I(GetUnitY(target))))
    call DebugHeroAttackState("ISSUE", source)
    set controlCall = DebugHeroControlBefore(source, "AttackMoveKill", " target=" + Int2Str(GetHandleId(target)) + " x=" + Int2Str(R2I(GetUnitX(target))) + " y=" + Int2Str(R2I(GetUnitY(target))), null)
  endif
  call AttackMoveKill(target)
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroAttackMoveXY takes integer x, integer y, string source returns nothing
  local integer controlCall = 0
  if debug_hero_tracking then
    set debug_attack_command = debug_attack_command + 1
    call DebugHeroLog("ATTACK COMMAND: operation=" + Int2Str(debug_attack_operation) + " command=" + Int2Str(debug_attack_command) + " source=" + source + " kind=point x=" + Int2Str(x) + " y=" + Int2Str(y))
    call DebugHeroAttackState("ISSUE", source)
    set controlCall = DebugHeroControlBefore(source, "AttackMoveXY", " x=" + Int2Str(x) + " y=" + Int2Str(y), null)
  endif
  call AttackMoveXY(x,y)
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroClearCaptainTargets takes string source returns nothing
  local integer controlCall = 0
  call DebugHeroAttackState("CLEAR_TARGETS_CALL", source)
  if debug_hero_tracking then
    set controlCall = DebugHeroControlBefore(source, "ClearCaptainTargets", "", null)
  endif
  call ClearCaptainTargets()
  call DebugHeroControlAfter(controlCall, null, "")
endfunction

function DebugHeroRetreatMembership takes unit u, string source returns nothing
  if debug_hero_tracking and u != null and IsUnitType(u, UNIT_TYPE_HERO) then
    call DebugHeroLog("HERO RETREAT MEMBERSHIP: source=" + source + DebugHeroState(u))
  endif
endfunction
