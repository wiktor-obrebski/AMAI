function DebugHeroRemoveGuardPosition takes unit u, string source returns nothing
  if debug_hero_tracking and u != null and IsUnitType(u, UNIT_TYPE_HERO) then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=RemoveGuardPosition" + DebugHeroState(u))
  endif
  call RemoveGuardPosition(u)
endfunction

function DebugHeroRecycleGuardPosition takes unit u, string source returns nothing
  if debug_hero_tracking and u != null and IsUnitType(u, UNIT_TYPE_HERO) then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=RecycleGuardPosition" + DebugHeroState(u))
  endif
  call RecycleGuardPosition(u)
endfunction

function DebugHeroCaptainGoHome takes string source returns nothing
  if debug_hero_tracking then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=CaptainGoHome")
  endif
  call CaptainGoHome()
endfunction

function DebugHeroCaptainAttack takes real x, real y, string source returns nothing
  if debug_hero_tracking then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=CaptainAttack" + " x=" + Int2Str(R2I(x)) + " y=" + Int2Str(R2I(y)))
  endif
  call CaptainAttack(x, y)
endfunction

function DebugHeroSetCaptainHome takes integer captain, real x, real y, string source returns nothing
  if debug_hero_tracking then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=SetCaptainHome" + " captain=" + Int2Str(captain) + " x=" + Int2Str(R2I(x)) + " y=" + Int2Str(R2I(y)))
  endif
  call SetCaptainHome(captain, x, y)
endfunction

function DebugHeroInitAssault takes string source returns nothing
  if debug_hero_tracking then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=InitAssault")
  endif
  call InitAssault()
endfunction

function DebugHeroAddAssault takes integer count, integer unitid, string source returns boolean
  if debug_hero_tracking then
    call DebugHeroLog("HERO CONTROL: source=" + source + " action=AddAssault" + " count=" + Int2Str(count) + " unitid=" + Int2Str(unitid))
  endif
  return AddAssault(count, unitid)
endfunction

